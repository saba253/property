# Copy to .env.local for local development. Never commit real credentials.
# These variables are read on the server only (no NEXT_PUBLIC_ prefix): they never reach the browser.

# Where listings come from:
#   memory   - the built-in demo data (default; no database needed)
#   postgres - PostgreSQL at DATABASE_URL. If it is missing or unreachable, pages fail with a
#              server error; there is no silent fallback to demo data.
DATA_BACKEND=memory

# Only for DATA_BACKEND=postgres and the db:* scripts. A LOCAL development database, for example:
# DATABASE_URL=postgres://property_dev@localhost:5432/property_dev
# The db:migrate and db:seed:demo scripts refuse non-local hosts (db:migrate accepts
# --allow-remote for a future, deliberate deployment step; db:seed:demo never does).
DATABASE_URL=

# --- Accounts (Better Auth), Steps 1.21-1.22 -------------------------------------------------
# Easiest local setup: node tools/local-dev/setup-env.mjs writes a complete .env.local with a
# generated secret for the bundled local PostgreSQL server and SMTP catcher (see db/README.md).
# Accounts stay OFF unless ALL of the following are set (see docs/AUTH.md). There is no demo or
# in-memory login: without them, /login and /register explain that accounts are not enabled yet.
AUTH_ENABLED=false
# DATABASE_URL (above) must point to PostgreSQL with migrations applied (npm run db:migrate).
# At least 32 random characters, different per environment. Generate, for example, with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public origin of the site (https in production), e.g. http://localhost:3000 for development.
BETTER_AUTH_URL=
# SMTP server for verification and password-reset emails, e.g. smtps://user:password@smtp.example.com:465
AUTH_SMTP_URL=
AUTH_EMAIL_FROM=
# Optional Google sign-in (both values from Google Cloud Console; never commit them).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Tests ------------------------------------------------------------------------------------
# Optional: a disposable LOCAL test database for tests/integration/real-postgres.test.ts (skipped
# when unset), e.g. postgres://USER:PASSWORD@127.0.0.1:5432/property_intelligence_dev_test (Windows
# service, created by tools/local-dev/setup-pg-role.mjs) or port 5433/property_test (bundled server).
# Set it in the shell for one run; it is not read from .env.local.
# TEST_DATABASE_URL=
