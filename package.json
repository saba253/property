{
  "name": "property",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:status": "node --import ./scripts/register-aliases.mjs scripts/db.mts status",
    "db:migrate": "node --import ./scripts/register-aliases.mjs scripts/db.mts migrate",
    "db:seed:demo": "node --import ./scripts/register-aliases.mjs scripts/db.mts seed-demo",
    "photos:orphans": "node --import ./scripts/register-aliases.mjs scripts/photos.mts",
    "roles": "node --import ./scripts/register-aliases.mjs scripts/roles.mts"
  },
  "dependencies": {
    "better-auth": "1.7.6",
    "kysely": "0.29.6",
    "leaflet": "1.9.4",
    "next": "16.4.0",
    "nodemailer": "10.0.13",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
